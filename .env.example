# .env.example — List of environment variables Baon needs.
# Copy this file to .env.local and fill in the values (.env.local is git-ignored).
# Only VITE_-prefixed values reach the browser, so never put secrets here.

# Neon Auth URL (Neon website → baon project → Auth / Better Auth page).
# Dev calls it directly; on Vercel the sign-in forwarder (api/auth.ts) reads it at run time.
VITE_NEON_AUTH_URL=

# Neon Data API URL (Neon website → baon project → Data API) — used from R1.1 for backups
VITE_NEON_DATA_API_URL=
